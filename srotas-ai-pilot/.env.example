# ============================================================
# AI Provider Configuration
# ============================================================

# Select the LLM backend: "gemini" | "openai" | "mock"
# Leave as "mock" to use the built-in Lithuanian sales agent simulator.
LLM_PROVIDER=mock

# ---- Google Gemini ----
# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=300
GEMINI_TEMPERATURE=0.3

# ---- OpenAI ----
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=300
OPENAI_TEMPERATURE=0.3

# ============================================================
# Voice Provider Configuration (New)
# ============================================================

# VOICE_MODE: "browser" (WebSpeech API) | "provider" (Deepgram + ElevenLabs)
VOICE_MODE=browser

# STT provider: "deepgram"
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# TTS provider: "elevenlabs"
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
